# --- Non secrets ---
APP_ENV=local
PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:3000
SSE_RETENTION_WINDOW_DAYS=30
PAYMENTS_LIVE_ENABLED=false
PSP_PROVIDER=fake            # fake | none   (fake interdit si APP_ENV=production)
MARKET_PROVIDER=manual       # manual uniquement tant qu'aucune source licenciée n'est validée
STORAGE_DIR=./storage
NOTIFICATION_CHANNELS=        # vide = push/email NON configurés (livraisons marquées NOT_CONFIGURED)
REDIS_URL=redis://127.0.0.1:56390
# --- Secrets (ne jamais committer de valeurs réelles) ---
DB_PRIMARY_URL=postgresql://ravzo:ravzo_dev_only@127.0.0.1:55440/ravzo
DB_READ_URL=
TOKEN_SECRET=change-me-dev-only-32-bytes-minimum-xxxxxxxx
CURSOR_SECRET=change-me-dev-only-cursor-secret-xxxxxxxxxxx
DOCUMENT_MASTER_KEY=   # 32 octets base64 ; requis pour les documents
WEBHOOK_VERIFY_SECRET=fake-provider-dev-secret
# --- Intégrations (valeurs réelles uniquement dans .env, jamais committées) ---
MANSA_API_BASE=https://mansaapi.com/api/v1
MANSA_API_KEY=
MANSA_DAILY_QUOTA=100
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RAVZO
SMTP_FROM_ADDRESS=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json


FEEXPAY_API_BASE=https://api-v2.feexpay.me   # sandbox : https://sandbox-api.feexpay.me
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_WEBHOOK_SECRET=        # fxp_whsec_... (menu Webhook, signature HMAC)
